# Copy to .env for local development. Never commit .env.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-strong-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Heroku sets DATABASE_URL automatically when the Postgres addon is attached.
# Leave unset for local development (falls back to db.sqlite3, which is gitignored).
DATABASE_URL=
